{
  "name": "social-age-backend",
  "version": "1.0.0",
  "private": true,
  "main": "app.js",
  "scripts": {
    "start": "node app.js --require dotenv/config",
    "dev": "nodemon app.js --require dotenv/config",
    "db:reset": "node --require dotenv/config scripts/resetDb.js",
    "seed:all": "npm run seed:users && npm run seed:applications && npm run seed:gatherings",
    "db:rebuild": "npm run db:reset && npm run seed:all",
    "seed:users": "node --require dotenv/config seeders/seedUsers.js",
    "seed:applications": "node --require dotenv/config seeders/seedApplications.js",
    "seed:gatherings": "node --require dotenv/config seeders/seedGatherings.js"
  },
  "dependencies": {
    "axios": "^1.8.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.9.15"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
